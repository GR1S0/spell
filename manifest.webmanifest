{
 "id": "/",
 "name": "SPELL",
 "short_name": "SPELL",
 "description": "I tuoi pensieri a voce, trascritti dal Mac",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#170937",
 "lang": "it",
 "share_target": {
  "action": "./condividi",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "audio",
     "accept": [
      "audio/*",
      ".m4a",
      ".mp3",
      ".wav",
      ".ogg",
      ".oga",
      ".opus",
      ".aac",
      ".amr",
      ".3gp",
      ".flac",
      ".webm",
      "text/plain",
      ".txt"
     ]
    }
   ]
  }
 },
 "icons": [
  {
   "src": "icon-192.png?v=9",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icon-512.png?v=9",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "avvio-768.png?v=9",
   "sizes": "768x768",
   "type": "image/png",
   "purpose": "any"
  }
 ]
}